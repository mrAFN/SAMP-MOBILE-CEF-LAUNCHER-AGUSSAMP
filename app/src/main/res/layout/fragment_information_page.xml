<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <!-- Background & Overlay -->
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PANEL KIRI (Clean & Minimalis) -->
    <LinearLayout
        android:id="@+id/leftGlassPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:layout_constraintEnd_toStartOf="@id/rightMenuColumn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <!-- Header: Logo Kecil + Teks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:contentDescription="@string/alyn_sa_mp"
                android:src="@drawable/samp_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="taxGuz Host"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.05"
                    android:text="TAXGUZ PLAY • MOBILE"
                    android:textColor="#8FA3B8"
                    android:textSize="@dimen/_6ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Deskripsi Singkat -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/montserrat"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:text="Project Phone CEF SA:MP Launcher V21."
            android:textColor="#B0C4D8"
            android:textSize="@dimen/_8ssp" />

        <!-- Status Online -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp">

            <View
                android:layout_width="@dimen/_5sdp"
                android:layout_height="@dimen/_5sdp"
                android:background="@drawable/circle_background" />

            <TextView
                android:id="@+id/onlinePlayersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/montserrat_bold"
                android:text="0/100 Online"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7ssp" />
        </LinearLayout>

        <!-- Spacer & Versi -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_10sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="v1.0.0 • android"
            android:textColor="#66FFFFFF"
            android:textSize="@dimen/_6ssp" />

        <!-- Server Info (IP & Gamemode) -->
        <LinearLayout
            android:id="@+id/serverCardsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:text="ADDRESS"
                    android:textColor="#8FA3B8"
                    android:textSize="@dimen/_6ssp" />

                <TextView
                    android:id="@+id/serverIpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="TaxGuz:7777"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:text="GAMEMODE"
                    android:textColor="#8FA3B8"
                    android:textSize="@dimen/_6ssp" />

                <TextView
                    android:id="@+id/gamemodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="AGUSSAMP RP"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <!-- Tombol Refresh Kecil -->
            <FrameLayout
                android:id="@+id/btnRefreshServer"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:background="@drawable/bg_settings_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- PANEL KANAN (Menu Bersih & Tipis) -->
    <LinearLayout
        android:id="@+id/rightMenuColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftGlassPanel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.42">

        <!-- Username Input (Slim) + Ikon Player -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/bg_glass_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_4sdp">

            <!-- Ikon Player (Menggantikan lingkaran biru) -->
            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:contentDescription="Player Icon"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00E5FF" />

            <LinearLayout
                android:id="@+id/usernameBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/montserrat_bold"
                    android:hint="Username / UCP"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:maxLength="24"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A9BA8"
                    android:textSize="@dimen/_9ssp"
                    tools:ignore="Autofill" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_settings_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tombol Menu: Join Discord (Super Tipis/Ramping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_glass_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_10sdp">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_discord"
                app:tint="#00E5FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:text="Join Discord Server"
                android:textColor="#D0DCE8"
                android:textSize="@dimen/_8ssp" />

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/ic_arrow_up"
                android:rotation="90"
                app:tint="#88FFFFFF" />
        </LinearLayout>

        <!-- Tombol Menu: Check Update (Super Tipis/Ramping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_glass_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_10sdp">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_refresh"
                app:tint="#00E5FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:text="Check for Updates"
                android:textColor="#D0DCE8"
                android:textSize="@dimen/_8ssp" />

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/ic_arrow_up"
                android:rotation="90"
                app:tint="#88FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM ROW: IP, Ikon Sosial, Play Button -->
    <LinearLayout
        android:id="@+id/bottomLeftLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- IP Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:background="@drawable/bg_server_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_10sdp">

            <View
                android:layout_width="@dimen/_5sdp"
                android:layout_height="@dimen/_5sdp"
                android:background="@drawable/circle_background" />

            <TextView
                android:id="@+id/serverAddressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:fontFamily="@font/montserrat_bold"
                android:text="TaxGuz:7777"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8ssp" />
        </LinearLayout>

        <!-- Ikon Sosial Kecil & Sejajar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconDiscord"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="@string/discord"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_discord"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/iconInstagram"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="Instagram"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_social_instagram"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/iconTiktok"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="TikTok"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_social_tiktok"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/iconWhatsapp"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="WhatsApp"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_social_whatsapp"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Play Game Button (Kecil & Proporsional) -->
    <LinearLayout
        android:id="@+id/btnPlay"
        android:layout_width="@dimen/_110sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_button_play"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="Play Game"
            android:textColor="#0A1628"
            android:textSize="@dimen/_10ssp" />

        <ImageView
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_play"
            app:tint="#0A1628" />
    </LinearLayout>

    <!-- Hidden Compat Views -->
    <FrameLayout android:id="@+id/newsCard" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <ImageView android:id="@+id/newsImage" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@null" />
    </FrameLayout>
    <FrameLayout android:id="@+id/btnTopUp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>