<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/settingsBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar: Back Button, Title, Send Log Button -->
    <LinearLayout
        android:id="@+id/topBarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/btnBackSettings"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_cyan_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Title Box -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/bg_cyan_pill"
            android:gravity="center"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="PENGATURAN"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Send Log Button -->
        <LinearLayout
            android:id="@+id/btnSendLog"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_cyan_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_15sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="KIRIM LOG"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Container Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_settings_row"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarSettings">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Chat Text Size -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_settings_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="UKURAN TEKS OBROLAN"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <!-- Segmented Option Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFont5"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFont7"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="7"
                            android:textColor="#000000"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFont10"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="10"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFont12"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="12"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Maximum Chat Lines -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_settings_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="MAKSIMUM BARIS OBROLAN"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <!-- Segmented Option Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnLines6"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="6"
                            android:textColor="#000000"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnLines8"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="8"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnLines10"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="10"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnLines15"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="15"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: FPS Limit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_settings_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="BATAS FPS"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <!-- Segmented Option Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFps30"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="30"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFps60"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="60"
                            android:textColor="#000000"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFps90"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="90"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFps120"
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_segment_button_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="120"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4: Toggle Switches Grid (3 columns) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Switch 1: Tampilkan FPS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_settings_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Tampilkan FPS"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchDisplayFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="#00DFEE" />
                    </LinearLayout>

                    <!-- Switch 2: Obrolan Suara -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_settings_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Obrolan Suara"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVoice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="#00DFEE" />
                    </LinearLayout>

                    <!-- Switch 3: HUD Kustom -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_settings_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="HUD Kustom"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchFullscreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="#00DFEE" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 5: Second Switches Grid Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Switch 4: Keyboard Sistem -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_settings_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Keyboard Sistem"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchSystemKeyboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="#00DFEE" />
                    </LinearLayout>

                    <!-- Switch 5: Waktu di Obrolan -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_settings_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Waktu di Obrolan"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchTimestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#FFFFFF"
                            app:trackTint="#00DFEE" />
                    </LinearLayout>

                    <!-- Empty Placeholder space to balance 3-column layout -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
