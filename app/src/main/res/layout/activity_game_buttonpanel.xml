<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/buttonpanel_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText,ContentDescription">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />

    <!-- ALT dan N berada pada baris tetap di atas panel, jadi tidak tertimpa saat panel dibuka penuh. -->
    <LinearLayout
        android:id="@+id/quick_keys_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline">

        <TextView
            android:id="@+id/button_alt"
            style="@style/PanelKey.Wide"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_1sdp"
            android:text="ALT" />

        <TextView
            android:id="@+id/button_n"
            style="@style/PanelKey.Letter"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_1sdp"
            android:text="N" />
    </LinearLayout>

    <!-- Panel utama dimulai di bawah ALT/N agar tidak pernah bertumpuk. -->
    <LinearLayout
        android:id="@+id/buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:background="@drawable/bg_panel_shell"
        android:padding="@dimen/_2sdp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quick_keys_row">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_extend"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_margin="@dimen/_1sdp"
                android:background="@drawable/bg_key_cyan"
                android:clickable="true"
                android:contentDescription="Tampilkan tombol"
                android:focusable="true"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_panel_apps" />

            <LinearLayout
                android:id="@+id/buttons_row_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_esc"
                    style="@style/PanelKey.Wide"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="ESC" />

                <TextView
                    android:id="@+id/button_tab"
                    style="@style/PanelKey.Wide"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="TAB" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons_rows_rest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_spc"
                    style="@style/PanelKey.Wide"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="SPC" />

                <TextView
                    android:id="@+id/button_f"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="F" />

                <TextView
                    android:id="@+id/button_h"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="H" />

                <TextView
                    android:id="@+id/button_2"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_y"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="Y" />

                <TextView
                    android:id="@+id/button_c"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="C" />

                <TextView
                    android:id="@+id/button_g"
                    style="@style/PanelKey.Letter"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_margin="@dimen/_1sdp"
                    android:text="G" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
