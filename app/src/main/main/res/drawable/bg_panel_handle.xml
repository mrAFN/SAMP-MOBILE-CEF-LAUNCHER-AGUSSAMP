<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#73101826" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#33FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
